{
  "name": "portfolio",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "version": "1.0.0",
  "license": "MIT",
  "description": "My personal portfolio built with Astro",
  "scripts": {
    "dev": "astro dev",
    "dev:network": "astro dev --host",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "preview:network": "astro preview --host",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "astro build && node --test scripts/",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/rss": "4.0.14",
    "@astrojs/sitemap": "3.6.0",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "4.5.10",
    "@fontsource/playfair-display": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "astro": "^5.18.2",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "eslint": "^8.57.1",
    "eslint-plugin-astro": "^0.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "wrangler": "^3.95.0"
  }
}