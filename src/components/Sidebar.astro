---
import { SOCIALS } from "@consts";

const pathname = Astro.url.pathname;

const links = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Writing" },
  { href: "/work", label: "Work" },
  { href: "/reading-list", label: "Reading" },
  { href: "/talks", label: "Talks" },
];

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

  <div style="
    max-width: 65rem;
    width: 100%;
    margin: 0.5rem auto 0.5rem;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    gap: 0;
    min-height: 3.5rem;
  ">
    <a href="/" class="font-bold text-base shrink-0" style="background-color: var(--fg); color: var(--bg); padding: 0.25rem 0.75rem;">bxrne</a>
    <nav class="hidden md:flex items-center ml-auto">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            "nav-link text-sm px-3",
            isActive(href) ? "font-bold" : "",
          ]}
          style="color: var(--fg);"
        >
          {label}
        </a>
      ))}
    </nav>
    <button id="menu-btn" class="md:hidden theme-btn shrink-0" aria-label="Menu" style="color: var(--fg); border-color: var(--border); margin-left: auto;">menu</button>
  </div>

<div id="drawer-overlay" class="fixed inset-0 z-40 hidden md:hidden" style="background-color: rgba(0,0,0,0.3)"></div>

<div id="drawer" class="fixed bottom-0 left-0 right-0 z-50 transform translate-y-full transition-transform duration-200 md:hidden" style="background: var(--card-bg); border: 2px solid var(--border);">
  <div class="flex items-center justify-end px-4 h-12">
    <button id="drawer-close" class="theme-btn" aria-label="Close menu" style="color: var(--fg); border-color: var(--border)">close</button>
  </div>
  <nav class="p-4 space-y-2">
    {links.map(({ href, label }) => (
      <a
        href={href}
        class="block px-3 py-2 text-sm"
        style={`border: 2px solid ${isActive(href) ? "var(--border)" : "transparent"}; background-color: ${isActive(href) ? "var(--accent)" : "transparent"}; color: ${isActive(href) ? "var(--bg)" : "var(--fg)"}`}
      >
        {label}
      </a>
    ))}
  </nav>
  <div class="p-4 space-y-3">
    <div class="flex items-center gap-0 text-xs" style="color: var(--fg)">
      {SOCIALS.map((social, i) => (
        <span>
          <a href={social.HREF} target="_blank">{social.NAME}</a>
          {i < SOCIALS.length - 1 && <span class="mx-2">/</span>}
        </span>
      ))}
    </div>
  </div>
</div>

<script>
  const menuBtn = document.getElementById("menu-btn")!;
  const drawer = document.getElementById("drawer")!;
  const overlay = document.getElementById("drawer-overlay")!;
  const closeBtn = document.getElementById("drawer-close")!;

  function open() {
    drawer.classList.remove("translate-y-full");
    overlay.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }
  function close() {
    drawer.classList.add("translate-y-full");
    overlay.classList.add("hidden");
    document.body.style.overflow = "";
  }

  menuBtn.addEventListener("click", open);
  closeBtn.addEventListener("click", close);
  overlay.addEventListener("click", close);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });
</script>

<style>
  .nav-link {
    transition: background 0.15s ease, color 0.15s ease;
    padding: 0.25rem 0.5rem;
  }
  .nav-link:hover {
    background: var(--card-bg);
    color: var(--fg);
  }
</style>
