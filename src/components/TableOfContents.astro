---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filtered.length > 0 && (
  <nav class="mb-8 border-2 p-3" style="border-color: var(--border)">
    <h2 class="text-xs font-bold mb-2 uppercase tracking-wider" style="color: var(--muted)">Contents</h2>
    <div class="text-xs leading-relaxed" style="color: var(--muted)">
      {filtered.map((h, i) => {
        const isLast = i === filtered.length - 1;
        const prefix = h.depth === 3 ? "│   ├──" : "    ├──";
        const lastPrefix = h.depth === 3 ? "│   └──" : "    └──";
        const p = isLast ? lastPrefix : prefix;
        return (
          <div>
            <a href={`#${h.slug}`} style="color: var(--muted)" class="no-bracket">
              {p} [{h.text}]
            </a>
          </div>
        );
      })}
    </div>
  </nav>
)}