---
import Head from "@components/Head.astro";
import Sidebar from "@components/Sidebar.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";


type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
	  <Head title={`${SITE.NAME} > ${title}`} description={description} />
  </head>
  <body>
    <Sidebar />
    <main class="mx-auto px-4 sm:px-6 md:px-8 w-full flex-1" style="max-width: 67rem;">
      <slot />
    </main>
    <Footer class="shrink-0" />
  </body>
</html>
