---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";

import TableOfContents from "@components/TableOfContents.astro";
import ProjectLinks from "@components/ProjectLinks.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, headings } = await post.render();
---

<PageLayout title={post.data.title} description={post.data.description}>
  <div class="mx-auto px-4 pt-2 pb-20" style="max-width: 68rem;">
    <div class="mt-6 mb-8">
      <div class="flex items-center gap-2 text-xs" style="color: var(--muted)">
        <FormattedDate date={post.data.date} />
        <span>/</span>
        <span>{readingTime(post.body)}</span>
      </div>
      <h1 class="font-bold text-lg mt-2" style="color: var(--fg)">
        {post.data.title}
      </h1>
      <div class="my-2 text-md" style="color: var(--muted)">
	      <ProjectLinks repo={post.data.repoURL} demo={post.data.demoURL} />
      </div>
    <TableOfContents headings={headings} />
    <article>
      <Content />
    </article>
  </div>
</PageLayout>
