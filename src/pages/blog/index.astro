---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import { readingTime } from "@lib/utils";

const data = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

type Acc = {
  [year: string]: CollectionEntry<"blog">[];
}

const posts = data.reduce((acc: Acc, post) => {
    const year = post.data.date.getFullYear().toString();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(post);
    return acc;
  }, {});

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));
---

<PageLayout title="Writing" description="Thoughts, guides, and notes.">
  <div class="mx-auto px-4 pt-2 pb-20" style="max-width: 68rem;">
    <div class="border-2 p-4" style="border-color: var(--border);">
      {years.map((year, yi) => {
        const isLastYear = yi === years.length - 1;
        const yearPrefix = isLastYear ? "└──" : "├──";
        return (
          <div class="text-sm leading-relaxed" style="color: var(--fg)">
            <span style="color: var(--muted)">{yearPrefix} {year}/</span>
            <div class="ml-6">
              {posts[year].map((post, pi) => {
                const isLastPost = pi === posts[year].length - 1;
                const postPrefix = isLastPost ? "└──" : "├──";
                return (
                  <div class="flex items-baseline gap-3">
                    <a href={`/blog/${post.slug}`}>
                      <span style="color: var(--muted)">{postPrefix}</span> {post.data.title}
                    </a>
                    <span class="text-xs shrink-0" style="color: var(--muted)">{readingTime(post.body)}</span>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</PageLayout>