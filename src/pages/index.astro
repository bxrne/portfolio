---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import ProjectsCarousel from "@components/ProjectsCarousel.astro";
import { HOME, SITE } from "@consts";
import { readingTime } from "@lib/utils";

const recentPosts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
<h1 class="sr-only">Adam Byrne, software engineer. Deterministic simulation, correctness, and low-level performance.</h1>
<div class="pt-4">
	    <div class="border-2" style="border-color: var(--border);">
	      <div class="flex items-baseline gap-3 px-4 py-2 text-xs font-bold" style="background-color: var(--fg); color: var(--bg); text-align: center;">
	        <span class="flex-1" style="text-align: center;">about</span>
	      </div>
	    <div class="p-4">
  <img
    src="/headshot.jpg"
    alt="Adam Byrne"
    class="float-left w-16 h-16 object-cover grayscale border-2 mr-3 mb-1"
    style="border-color: var(--border);"
  />

  <p class="text-sm leading-relaxed">
I’m Adam. I’ve been coding professionally since before the LLM boom and completed an MSc via ISE, spending half my degree shipping production software across industry residencies.

Focused on deterministic simulation, correctness, and low-level performance.
  </p>

  <div class="clear-both"></div>
</div>
	    </div>

    <div class="border-2 mt-5" style="border-color: var(--border);">
      <div class="flex items-baseline gap-3 px-4 py-2 text-xs font-bold" style="background-color: var(--fg); color: var(--bg); text-align: center;">
        <span class="flex-1" style="text-align: center;">projects</span>
      </div>
      <ProjectsCarousel />
    </div>

    <div class="border-2 mt-5" style="border-color: var(--border);">
      <div class="flex items-baseline gap-3 px-4 py-2 text-xs font-bold" style="background-color: var(--fg); color: var(--bg); text-align: center;">
        <span class="flex-1" style="text-align: center;">recent writing</span>
      </div>
      {recentPosts.map((post, index) => (
        <a
          href={`/blog/${post.slug}`}
          class="no-bracket flex items-start gap-3 p-3 hover:bg-black/5 transition-colors group"
          style={`${index < recentPosts.length - 1 ? "border-bottom: 2px solid var(--border);" : ""}${index % 2 !== 0 ? " background-color: var(--card-bg);" : ""}`}
        >
          <div class="shrink-0 w-8 h-8 flex items-center justify-center text-xs font-mono" style="background-color: var(--card-bg); color: var(--muted);">
            {String(index + 1).padStart(2, "0")}
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline justify-between gap-2">
              <span class="text-sm font-medium">[{post.data.title}]</span>
              <span class="text-xs shrink-0" style="color: var(--muted);">{readingTime(post.body)}</span>
            </div>
            <p class="text-xs mt-1 line-clamp-1" style="color: var(--muted);">{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="border-2 mt-5" style="border-color: var(--border);">
      <div class="flex items-baseline gap-3 px-4 py-2 text-xs font-bold" style="background-color: var(--fg); color: var(--bg); text-align: center;">
        <span class="flex-1" style="text-align: center;">elsewhere</span>
      </div>
      <div class="p-3 text-sm flex flex-wrap gap-x-4 gap-y-1" style="border-color: var(--border);">
        <a href="https://github.com/bxrne" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/bxrne" target="_blank" rel="noreferrer">LinkedIn</a>
        <a href="https://twitter.com/abxrne" target="_blank" rel="noreferrer">Twitter</a>
        <a href="/resume.pdf" target="_blank" rel="noreferrer">CV</a>
      </div>
    </div>

  </div>
</PageLayout>
