---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";

const talks = (await getCollection("talks"))
	.filter((t) => !t.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout title="Talks" description="Presentations and talks I've given.">
	<div class="pt-4">
		<div class="border-2" style="border-color: var(--border);">
			<div class="flex items-baseline gap-3 px-4 py-2 text-xs font-bold" style="background-color: var(--fg); color: var(--bg); text-align: center;">
				<span class="flex-1" style="text-align: center;">talks</span>
			</div>
			<div class="p-4">
				<div class="flex flex-col gap-3">
					{talks.map((talk) => (
						<div>
							<div class="flex items-start gap-3">
								<div class="flex-1 min-w-0">
									{talk.data.url ? (
										<a href={talk.data.url} target="_blank" rel="noreferrer" class="no-bracket block">
											<span class="text-sm font-bold">[{talk.data.title}]</span>
										</a>
									) : (
										<span class="text-sm font-bold">{talk.data.title}</span>
									)}
									<div class="text-xs mt-0.5" style="color: var(--muted);">{talk.data.location} · {talk.data.date.toLocaleDateString("en-US", { month: "short", year: "numeric" })}</div>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</div>
</PageLayout>
