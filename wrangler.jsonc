{
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.jsonc",
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}